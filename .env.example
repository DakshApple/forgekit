# Copy to .env.local. Later phases add more variables; see docs/env.md.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@forgekit.example

# Supabase (service role key is server only, never expose it to the browser)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Publishable (anon) key, used for admin sign in only
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma separated allowlist of admin emails
ADMIN_EMAILS=

# Razorpay (use test keys until launch)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (Resend or Nodemailer)
RESEND_API_KEY=
EMAIL_FROM="Forgekit <keys@forgekit.example>"

# Admin auth (NextAuth or Supabase Auth)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
